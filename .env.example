# Desenvolvimento local. Gere novos valores com: python scripts/setup_env.py
POSTGRES_DB=osint
POSTGRES_USER=osint
POSTGRES_PASSWORD=replace-with-a-random-local-password
ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,api,web,testserver
CONNECTOR_SECRET_KEY=
SESSION_TTL_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PER_MINUTE=120
EVIDENCE_MAX_BYTES=20971520
COLLECTION_MAX_RECORDS=100
COLLECTION_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=4
SCHEDULER_TICK_SECONDS=15
AI_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
# Endpoint opcional administrado pelo operador para integração Kali/MCP.
KALI_MCP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=osint-tracker@localhost
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# HTTPS de produção: edite HOSTNAME, CORS_ORIGINS e TRUSTED_HOSTS.
HOSTNAME=osint.example.org
ACME_EMAIL=admin@example.org
# Portas publicadas somente no loopback no ambiente de desenvolvimento.
API_PORT=8000
WEB_PORT=3000
